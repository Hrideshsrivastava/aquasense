# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorised redirect URI: http://localhost:8000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=change-me-to-a-long-random-string
BASE_URL=http://localhost:8000
# Comma-separated Gmail addresses. Everyone else who signs in is a customer.
ADMIN_EMAILS=you@gmail.com,admin@example.com
TECH_EMAILS=tech@example.com
# Local testing without Google. NEVER set to 1 in production.
AUTH_DEV=0  # set to 1 only for local demos without Google
